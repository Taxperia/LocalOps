{
  "name": "localops",
  "productName": "LocalOps",
  "version": "1.0.0",
  "description": "LocalOps — Your Windows. Fully Under Control.",
  "author": "LocalOps",
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Taxperia/LocalOps.git"
  },
  "homepage": "https://github.com/Taxperia/LocalOps",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.localops.app",
    "productName": "LocalOps",
    "publish": [
      {
        "provider": "github",
        "owner": "Taxperia",
        "repo": "LocalOps",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LocalOps-Setup-${version}.${ext}",
      "shortcutName": "LocalOps"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
